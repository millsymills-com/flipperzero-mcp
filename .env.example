# Transport: auto (USB first, WiFi fallback if FLIPPER_WIFI_HOST set), usb, or wifi
FLIPPER_TRANSPORT=auto
# FLIPPER_USB_PORT=/dev/tty.usbmodemflip_1
FLIPPER_USB_BAUDRATE=115200
# FLIPPER_WIFI_HOST=192.168.1.100
FLIPPER_WIFI_PORT=8080
# Allow device-mutating storage writes (fs_push, fs_mkdir)
FLIPPER_ENABLE_WRITE_TOOLS=false
# Allow transmit/destructive CLI commands (still needs i_accept_responsibility per call)
FLIPPER_ENABLE_TX_TOOLS=false
FLIPPER_DEBUG=false
